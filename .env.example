# Скопируй в .env:  cp .env.example .env  (права 600, файл в .gitignore)
# --- Вариант A: Upload-Post (использует skills/reels-publisher/scripts/publish_reel.py) ---
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# --- Вариант B: Blotato (замена Upload-Post; API base https://api.blotato.com) ---
BLOTATO_API_KEY=
BLOTATO_WORKSPACE_ID=

# --- Вариант C: Postiz (self-hosted или облако postiz.com) ---
POSTIZ_URL=https://api.postiz.com
POSTIZ_API_KEY=

# --- Вариант D: напрямую Instagram Graph API (без посредников) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# публичный HTTPS-URL видео (нужен хостинг файла: S3/R2/свой сервер)
MEDIA_PUBLIC_URL=
